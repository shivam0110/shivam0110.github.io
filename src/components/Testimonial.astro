---
import type { Testimonial } from '../data/portfolio';
interface Props { item: Testimonial; }
const { item } = Astro.props;
---
{(item.approved || import.meta.env.DEV) && <figure class="testimonial">
  {!item.approved && <span class="draft-label">Draft · awaiting author approval</span>}
  <span class="quote-mark" aria-hidden="true">“</span>
  <blockquote><p>{item.quote}</p></blockquote>
  <figcaption><span class="avatar" aria-hidden="true">{item.company.slice(0, 1)}</span><span><strong>{item.name}</strong><small>{item.role} · {item.company}</small></span></figcaption>
</figure>}
