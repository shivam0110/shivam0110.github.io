---
import { testimonials } from '../data/portfolio';
const visible = testimonials.filter((item) => item.approved || import.meta.env.DEV);
---
{visible.length > 0 && <section class="testimonials section shell" aria-labelledby="testimonials-title">
  <div class="section-heading"><div><p class="eyebrow">GOOD WORK IS A TEAM SPORT</p><h2 id="testimonials-title">People I’ve worked with<span class="accent">.</span></h2></div></div>
  <div class="testimonial-grid">{visible.map((item) => <figure class="testimonial">
    {!item.approved && <span class="draft-label">Draft · awaiting author approval</span>}
    <span class="quote-mark" aria-hidden="true">“</span>
    <blockquote><p>{item.quote}</p></blockquote>
    <figcaption><span class="avatar" aria-hidden="true">{item.company.slice(0, 1)}</span><span><strong>{item.name}</strong><small>{item.role} · {item.company}</small></span></figcaption>
  </figure>)}</div>
</section>}
