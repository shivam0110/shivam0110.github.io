---
import Base from '../layouts/Base.astro';
import StackDemo from '../components/StackDemo.astro';
import Testimonials from '../components/Testimonials.astro';
import { experience, profile, projects } from '../data/portfolio';
const [stackhub, ...otherProjects] = projects;
---
<Base>
  <section class="hero shell" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> SOFTWARE ENGINEER · BENGALURU</p>
      <h1 id="intro-title">Complex problems.<br />Useful <span class="serif accent">products.</span></h1>
      <p class="hero-description">I’m Shivam. I build AI products and developer tools that make complex work simpler.</p>
      <div class="hero-actions"><a class="button" href="#work">Explore my work <span aria-hidden="true">↘</span></a><a class="text-link" href={`mailto:${profile.email}`}>Get in touch <span aria-hidden="true">↗</span></a></div>
      <p class="hero-footnote">Currently at <strong>Karbon.</strong> Previously founding engineer at <strong>Kusho.ai.</strong></p>
    </div>
    <div class="hero-art" aria-label="From a complex idea to a useful product">
      <span class="art-label">THE PART I ENJOY MOST</span>
      <div class="idea-orbit"><span class="orbit-node node-a">context</span><span class="orbit-node node-b">systems</span><span class="orbit-node node-c">people</span><span class="orbit-node node-d">code</span><div class="orbit-core"><span aria-hidden="true">✳</span><strong>make it<br />work.</strong></div></div>
      <div class="art-caption"><span>From the messy middle<br />to something useful.</span><span class="art-arrow" aria-hidden="true">↗</span></div>
    </div>
  </section>
  <div class="focus-strip shell"><span>A FEW THINGS I CARE ABOUT</span><p>AI engineering <i>/</i> Full-stack ownership <i>/</i> Developer experience</p></div>

  <section class="section shell" id="work" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">SELECTED WORK / 01—03</p><h2 id="work-title">Built to be used<span class="accent">.</span></h2></div><p>A few projects at the intersection<br />of systems, AI, and everyday work.</p></div>
    <article class="featured-project">
      <div class="project-copy"><p class="eyebrow">{stackhub.number} / {stackhub.category}</p><h3>{stackhub.title}</h3><p>{stackhub.description}</p><ul class="tags">{stackhub.tags.map((tag) => <li>{tag}</li>)}</ul><a class="text-link" href={`/work/${stackhub.slug}/`}>Explore the project <span aria-hidden="true">↗</span></a><a class="quiet-link" href="https://github.com/shivam0110/stackhub">View source on GitHub ↗</a></div>
      <div class="stack-stage"><StackDemo /></div>
    </article>
    <div class="project-grid">{otherProjects.map((project) => <article class="project-card">
      <a class:list={['project-visual', project.slug]} href={`/work/${project.slug}/`} aria-label={`Explore ${project.title}`}>
        {project.slug === 'invoice-processing' ? <div class="invoice-demo" aria-hidden="true"><div class="mini-label"><span class="mini-icon">▤</span> A CLEARER REVIEW WORKFLOW</div><div class="invoice-paper"><div class="invoice-paper-top"><span>Invoice</span><span>Review queue</span></div><div class="paper-lines"><i></i><i></i><i></i></div><div class="invoice-item"><span>Extract</span><span>Validate</span><span class="review-pill">Review ↗</span></div></div><span class="illustration-label">Workflow illustration</span></div> : <div class="agent-demo" aria-hidden="true"><div class="mini-label">FROM CONTEXT TO PROTOTYPE</div><div class="context-node">Enterprise context</div><div class="agent-connectors"></div><div class="agent-row"><span>Research</span><span>Plan</span><span>Build</span></div><div class="agent-connectors bottom"></div><div class="prototype-node">A tangible prototype <span>↗</span></div><span class="illustration-label">Conceptual architecture</span></div>}
        <span class="visual-link" aria-hidden="true">↗</span>
      </a>
      <div class="card-copy"><p class="eyebrow">{project.number} / {project.category}</p><h3><a href={`/work/${project.slug}/`}>{project.title}</a></h3><p>{project.description}</p><ul class="tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul><a class="text-link" href={`/work/${project.slug}/`}>Read project overview <span aria-hidden="true">↗</span></a></div>
    </article>)}</div>
    <a class="github-note" href={profile.github}><span>Always building, always learning.</span><span>More on GitHub ↗</span></a>
  </section>

  <section class="experience section shell" id="experience" aria-labelledby="experience-title">
    <div class="section-heading"><div><p class="eyebrow">THE JOURNEY SO FAR</p><h2 id="experience-title">Small teams.<br />Real ownership<span class="accent">.</span></h2></div><p>From a startup’s first hire<br />to building complex product systems.</p></div>
    <div class="experience-list">{experience.map((job) => <article class="experience-row"><span class="job-period">{job.period}</span><div><h3>{job.company}</h3><span class="job-role">{job.role}</span></div><p>{job.text}</p></article>)}</div>
  </section>
  <Testimonials />
  <section class="about section shell" id="about" aria-labelledby="about-title">
    <div><p class="eyebrow">A LITTLE ABOUT ME</p><h2 id="about-title">Curious by default.<br /><span class="serif">Practical by choice.</span></h2></div>
    <div class="about-copy"><p>I like the part of engineering where an ambiguous problem becomes something people can actually use.</p><p>That might mean connecting an AI workflow, making a complicated interface feel straightforward, or building a tool that removes a little friction from another developer’s day.</p><p>I care about the whole path: understanding the problem, making the trade-offs, and getting the details right.</p><a class="text-link" href={profile.linkedin}>Find me on LinkedIn <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="contact" id="contact" aria-labelledby="contact-title"><div class="shell"><p class="eyebrow">LET’S BUILD SOMETHING USEFUL</p><div class="contact-heading"><h2 id="contact-title">Have a good<br /><span class="serif">problem?</span></h2><a class="contact-arrow" href={`mailto:${profile.email}`} aria-label="Email Shivam">↗</a></div><div class="contact-bottom"><a href={`mailto:${profile.email}`}>{profile.email} ↗</a><a href={`tel:${profile.phone.replaceAll('-', '')}`}>{profile.phone}</a><div><a href={profile.linkedin}>LinkedIn ↗</a><a href={profile.github}>GitHub ↗</a></div></div></div></section>
</Base>
