---
import Base from './Base.astro';
import Testimonial from '../components/Testimonial.astro';
import { experience, profile, projects, testimonials } from '../data/portfolio';
interface Props { frontmatter: { slug: string; }; }
const job = experience.find((job) => job.slug === Astro.props.frontmatter.slug);
if (!job) throw new Error(`Unknown experience: ${Astro.props.frontmatter.slug}`);
const testimonial = testimonials.find((item) => item.company === job.company);
const relatedProjects = projects.filter((project) => job.projects.includes(project.slug));
---
<Base title={`${job.company} — Experience — Shivam Malpani`} description={job.text}>
  <article class="case-study shell">
    <a class="text-link" href="/#experience">← All experience</a>
    <header class="case-header">
      <p class="eyebrow">{job.dates} · Bengaluru</p>
      <h1>{job.company}<span class="accent">.</span></h1>
      <p class="experience-role">{job.role}</p>
      <p class="case-description">{job.text}</p>
      <ul class="tags" aria-label="Technologies and tools">{job.tags.map((tag) => <li>{tag}</li>)}</ul>
    </header>
    <div class="experience-body">
      <div class="prose"><slot /></div>
      <aside class="experience-aside" aria-label="Colleague testimonial and related projects">
        {testimonial && <Testimonial item={testimonial} />}
        {relatedProjects.length > 0 && <div class="experience-projects"><p class="eyebrow">EXPLORE THE WORK</p>{relatedProjects.map((project) => <a class="text-link" href={`/work/${project.slug}/`}>{project.title} <span aria-hidden="true">↗</span></a>)}</div>}
      </aside>
    </div>
    <aside class="case-next"><p class="eyebrow">MORE EXPERIENCE</p>{experience.filter((item) => item.slug !== job.slug).map((item) => <a href={`/experience/${item.slug}/`}>{item.company} ↗</a>)}</aside>
    <a class="button" href={`mailto:${profile.email}`}>Let’s talk about the work ↗</a>
  </article>
</Base>
