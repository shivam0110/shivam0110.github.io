---
import Base from './Base.astro';
import StackDemo from '../components/StackDemo.astro';
import { projects, profile } from '../data/portfolio';
interface Props { frontmatter: { title: string; description: string; category: string; stackDemo?: boolean; }; }
const { title, description, category, stackDemo } = Astro.props.frontmatter;
const project = projects.find((project) => project.title === title);
---
<Base title={`${title} — Shivam Malpani`} description={description}>
  <article class="case-study shell">
    <a class="text-link" href="/#work">← All projects</a>
    <header class="case-header"><p class="eyebrow">{category}</p><h1>{title}<span class="accent">.</span></h1><p class="case-description">{description}</p>{project && <ul class="tags" aria-label="Project technologies">{project.tags.map((tag) => <li>{tag}</li>)}</ul>}</header>
    {stackDemo && <div class="case-demo"><StackDemo /></div>}
    <div class="prose"><slot /></div>
    <aside class="case-next"><p class="eyebrow">KEEP EXPLORING</p>{projects.filter((project) => project.title !== title).map((project) => <a href={`/work/${project.slug}/`}>{project.title} ↗</a>)}</aside>
    <a class="button" href={`mailto:${profile.email}`}>Let’s talk about the work ↗</a>
  </article>
</Base>
